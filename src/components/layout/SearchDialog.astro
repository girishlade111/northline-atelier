---
/**
 * SearchDialog — native <dialog> with an input that live-filters a
 * build-time JSON index (projects + section shortcuts). Arrow-key navigation.
 */
import type { Locale } from '../../config/site';
import { useTranslations } from '../../i18n/ui';
import Icon from '../ui/Icon.astro';

export interface SearchItem {
  title: string;
  subtitle: string;
  href: string;
}

interface Props {
  locale: Locale;
  index: SearchItem[];
}
const { locale, index } = Astro.props;
const t = useTranslations(locale);
---

<dialog class="search-dialog" id="search-dialog" aria-label={t.search.label}>
  <div class="search-inner">
    <form method="dialog" class="search-bar">
      <Icon name="search" size={20} class="search-icon" />
      <input
        type="search"
        id="search-input"
        placeholder={t.search.placeholder}
        aria-label={t.search.label}
        autocomplete="off"
        role="combobox"
        aria-expanded="false"
        aria-controls="search-results"
        aria-activedescendant=""
      />
      <button type="submit" class="icon-btn" aria-label={t.header.close}>
        <Icon name="close" size={20} />
      </button>
    </form>
    <p class="search-hint" id="search-hint">{t.search.hint}</p>
    <ul class="search-results" id="search-results" role="listbox" aria-label={t.search.label}></ul>
    <p class="search-empty" id="search-empty" hidden>{t.search.noResults}</p>
  </div>
</dialog>

<script id="search-index" type="application/json" set:html={JSON.stringify(index)} />

<script>
  const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const list = document.getElementById('search-results') as HTMLUListElement | null;
  const empty = document.getElementById('search-empty') as HTMLParagraphElement | null;
  const hint = document.getElementById('search-hint') as HTMLParagraphElement | null;

  type Item = { title: string; subtitle: string; href: string };
  const raw = document.getElementById('search-index')?.textContent ?? '[]';
  const index: Item[] = JSON.parse(raw);

  let active = -1;
  let current: Item[] = [];

  function render(q: string) {
    if (!list || !input) return;
    const query = q.trim().toLowerCase();
    current = query
      ? index.filter((i) => `${i.title} ${i.subtitle}`.toLowerCase().includes(query)).slice(0, 8)
      : [];
    active = -1;
    input.setAttribute('aria-activedescendant', '');
    list.innerHTML = '';
    current.forEach((item, idx) => {
      const li = document.createElement('li');
      li.id = `search-opt-${idx}`;
      li.setAttribute('role', 'option');
      const a = document.createElement('a');
      a.href = item.href;
      const strong = document.createElement('strong');
      strong.textContent = item.title;
      const span = document.createElement('span');
      span.textContent = item.subtitle;
      a.append(strong, span);
      li.append(a);
      list.append(li);
    });
    const hasQuery = query.length > 0;
    if (list) list.hidden = !hasQuery;
    if (empty) empty.hidden = !(hasQuery && current.length === 0);
    if (hint) hint.hidden = hasQuery;
    input.setAttribute('aria-expanded', String(hasQuery && current.length > 0));
  }

  function setActive(idx: number) {
    if (!list || !input) return;
    const opts = list.querySelectorAll('li');
    opts.forEach((o) => o.classList.remove('active'));
    if (idx >= 0 && idx < opts.length) {
      opts[idx].classList.add('active');
      input.setAttribute('aria-activedescendant', opts[idx].id);
    } else {
      input.setAttribute('aria-activedescendant', '');
    }
    active = idx;
  }

  input?.addEventListener('input', () => render(input.value));
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      setActive(Math.min(active + 1, current.length - 1));
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setActive(Math.max(active - 1, -1));
    } else if (e.key === 'Enter' && active >= 0) {
      e.preventDefault();
      const link = list?.querySelectorAll('li')[active]?.querySelector('a');
      dialog?.close();
      if (link) window.location.assign(link.href);
    }
  });

  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog?.addEventListener('close', () => {
    if (input) {
      input.value = '';
      render('');
    }
  });
  // Focus the input when the dialog opens.
  new MutationObserver(() => {
    if (dialog?.open) input?.focus();
  }).observe(dialog as Node, { attributes: true, attributeFilter: ['open'] });
</script>

<style>
  .search-dialog {
    padding: 0;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--ink);
    width: min(640px, calc(100vw - 40px));
    margin: 12vh auto auto;
    max-height: 70vh;
  }
  .search-dialog::backdrop {
    background: rgba(27, 26, 23, 0.35);
  }
  .search-inner {
    padding: 8px 8px 16px;
  }
  .search-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 8px 8px 16px;
    border-bottom: 1px solid var(--line);
  }
  :global(.search-icon) {
    flex: none;
    color: var(--ink-muted);
  }
  .search-bar input {
    flex: 1;
    border: 0;
    background: transparent;
    font-size: 16px;
    padding: 10px 0;
    min-width: 0;
  }
  .search-bar input:focus {
    outline: none;
  }
  .search-bar:focus-within {
    border-bottom-color: var(--olive);
  }
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
  }
  .search-hint {
    padding: 14px 16px 0;
    font-size: 12px;
    color: var(--ink-muted);
  }
  .search-results {
    padding: 8px;
  }
  .search-results a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
  }
  .search-results li.active a,
  .search-results a:hover {
    background: var(--bg-alt);
  }
  .search-results strong {
    font-size: 14px;
    font-weight: 500;
  }
  .search-results span {
    font-size: 12px;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .search-empty {
    padding: 18px 16px 6px;
    font-size: 13px;
    color: var(--ink-muted);
  }
</style>
