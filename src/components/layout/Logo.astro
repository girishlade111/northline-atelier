---
/** Wordmark: NORTHLINE (Cormorant, letterspaced) over centered ATELIER. */
import { site } from '../../config/site';

interface Props {
  href?: string;
}
const { href = '/' } = Astro.props;
---

<a href={href} class="logo" aria-label={`${site.name} ${site.subName} — home`}>
  <span class="wordmark">{site.name}</span>
  <span class="sub">{site.subName}</span>
</a>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    align-items: stretch;
    line-height: 1;
    color: var(--ink);
  }
  .wordmark {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 500;
    letter-spacing: 0.28em;
    white-space: nowrap;
  }
  .sub {
    margin-top: 5px;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.4em;
    text-align: center;
    text-indent: 0.4em; /* optically re-center letterspaced text */
    color: var(--ink);
  }

  /* Keep the wordmark from squeezing header actions on very small screens */
  @media (max-width: 767px) {
    .wordmark {
      font-size: 19px;
    }
    .sub {
      font-size: 9px;
    }
  }
</style>
