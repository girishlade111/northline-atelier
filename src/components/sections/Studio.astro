---
/**
 * Studio — image left, copy right, floor-plan panel behind on the far right.
 */
import type { Locale } from '../../config/site';
import { useTranslations } from '../../i18n/ui';
import { Picture } from 'astro:assets';
import studioImg from '../../assets/images/studio-interior.jpg';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import Reveal from '../ui/Reveal.astro';
import FloorPlan from '../decor/FloorPlan.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const studioHref = '#contact';
---

<section class="studio hairline-top hairline-bottom" id="studio" aria-label={t.studio.eyebrow}>
  <aside class="studio-panel" aria-hidden="true">
    <FloorPlan />
  </aside>

  <div class="wrap studio-inner">
    <Reveal class="studio-media">
      <Picture
        src={studioImg}
        formats={['avif', 'webp', 'jpg']}
        widths={[700, 1100, 1400]}
        sizes="(max-width: 1023px) 90vw, 561px"
        width={1800}
        height={1080}
        alt={t.studio.alt}
        loading="lazy"
      />
    </Reveal>

    <div class="studio-copy">
      <Reveal><Eyebrow text={t.studio.eyebrow} trail /></Reveal>
      <Reveal i={1}>
        <h2 class="studio-h2">
          {t.studio.title.map((line) => (
            <span class="h2-line">{line}</span>
          ))}
        </h2>
      </Reveal>
      <Reveal i={2}><p class="studio-lead">{t.studio.lead}</p></Reveal>
      <Reveal i={3}>
        <Button href={studioHref} variant="outline" class="studio-cta">{t.studio.cta}</Button>
      </Reveal>
    </div>
  </div>
</section>

<style>
  .studio {
    position: relative;
    overflow: clip;
  }
  .studio-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 28%;
    background: var(--bg-alt);
    border-left: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px;
    pointer-events: none;
  }
  .studio-panel :global(.floorplan) {
    max-height: 100%;
    width: auto;
    max-width: 100%;
  }

  .studio-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 561px 1fr;
    gap: 77px;
    align-items: center;
    padding-block: clamp(48px, 4.5vw, 64px);
    min-height: 426px;
  }

  /* .studio-media is the Reveal component root (no parent cid): globalize */
  :global(.studio-media) img {
    width: 100%;
    height: auto;
    aspect-ratio: 1.66 / 1;
    object-fit: cover;
  }

  .studio-h2 {
    margin: 22px 0 18px;
  }
  .h2-line {
    display: block;
  }
  .studio-lead {
    max-width: 550px;
    font-size: 14px;
    color: var(--ink-muted);
    margin-bottom: 30px;
    position: relative;
  }
  :global(.studio-cta) {
    width: 307px;
    min-height: 59px;
  }

  @media (max-width: 1279px) {
    .studio-inner {
      grid-template-columns: minmax(0, 480px) 1fr;
      gap: 48px;
    }
    :global(.studio-cta) {
      width: min(307px, 100%);
    }
  }

  @media (max-width: 1023px) {
    .studio-inner {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    :global(.studio-media) img {
      aspect-ratio: 1.66 / 1;
    }
    .studio-panel {
      top: auto;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      height: 46%;
      border-left: 0;
      border-top: 1px solid var(--line);
      opacity: 0.5;
    }
  }

  @media (max-width: 767px) {
    :global(.studio-cta) {
      width: 100%;
    }
  }
</style>
