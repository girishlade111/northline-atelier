---
/**
 * Stats band — paper-grain texture, hairline rules between/around stats,
 * serif numerals with count-up on first view (real numbers in HTML for no-JS).
 */
import type { Locale } from '../../config/site';
import { useTranslations } from '../../i18n/ui';
import Reveal from '../ui/Reveal.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="stats hairline-top hairline-bottom" aria-label="Studio statistics">
  <div class="stats-row">
    {t.stats.items.map((s, i) => (
      <>
        <span class="rule" aria-hidden="true"></span>
        <Reveal class="stat" i={i}>
          <span class="numeral" data-count={s.value} data-suffix={s.suffix}>
            {s.value}{s.suffix}
          </span>
          <span class="stat-label">{s.label}</span>
        </Reveal>
      </>
    ))}
    <span class="rule" aria-hidden="true"></span>
  </div>
</section>

<style>
  .stats {
    position: relative;
    background: var(--bg-paper);
    min-height: 186px;
    display: flex;
    align-items: center;
    overflow: clip;
  }
  /* Paper grain: inline SVG turbulence at ~6% opacity */
  .stats::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.06;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
    background-size: 240px 240px;
  }

  .stats-row {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
  }
  .rule {
    flex: 1 1 0;
    height: 1px;
    background: var(--line);
    /* align rules with the middle of the numerals, not the labels */
    transform: translateY(-12px);
  }
  :global(.stat) {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 28px clamp(18px, 3vw, 44px);
    text-align: center;
  }
  .numeral {
    font-family: var(--font-display);
    font-size: var(--stat-size);
    font-weight: 400;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stat-label {
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    .stats {
      min-height: 0;
      padding: 44px var(--gutter);
    }
    .stats-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 32px 16px;
    }
    .rule {
      display: none;
    }
    :global(.stat) {
      padding: 0;
    }
    .stat-label {
      white-space: normal;
      letter-spacing: 0.12em;
      font-size: 10px;
    }
  }
</style>
