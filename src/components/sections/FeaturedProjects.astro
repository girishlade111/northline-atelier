---
/**
 * FeaturedProjects — header row + 3-col grid of ProjectCards,
 * rendered from the `projects` content collection (featured, ordered).
 */
import type { Locale } from '../../config/site';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/ui';
import ArrowLink from '../ui/ArrowLink.astro';
import Reveal from '../ui/Reveal.astro';
import ProjectCard from '../ui/ProjectCard.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const allHref = '#projects';
---

<section class="projects hairline-bottom" id="projects" aria-label={t.projects.eyebrow}>
  <div class="wrap">
    <div class="projects-head">
      <Reveal><h2 class="projects-title micro">{t.projects.eyebrow}</h2></Reveal>
      <Reveal i={1}>
        <ArrowLink href={allHref}>{t.projects.viewAll}</ArrowLink>
      </Reveal>
    </div>

    <div class="projects-grid">
      {projects.map((p, i) => (
        <Reveal as="div" i={i}>
          <ProjectCard
            locale={locale}
            slug={p.id.replace(/\.md$/, '')}
            title={p.data.title}
            category={p.data.category}
            location={p.data.location[locale]}
            image={p.data.image}
            alt={p.data.alt?.[locale] ?? p.data.title}
          />
        </Reveal>
      ))}
    </div>
  </div>
</section>

<style>
  .projects {
    padding-block: 50px;
  }
  .projects-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 34px;
  }
  .projects-title {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  @media (max-width: 1023px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .projects-grid > :last-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 767px) {
    .projects {
      padding-block: 44px;
    }
    .projects-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 20px;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      padding-bottom: 8px;
      scrollbar-width: thin;
    }
    .projects-grid > * {
      flex: 0 0 82%;
      scroll-snap-align: start;
    }
  }
</style>
