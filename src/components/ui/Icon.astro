---
/**
 * Icon — inline SVG set, thin architectural line style.
 * `name` selects the glyph; `size` defaults to 20px.
 */
interface Props {
  name:
    | 'search'
    | 'menu'
    | 'close'
    | 'arrow'
    | 'chevron'
    | 'pin'
    | 'mail'
    | 'phone'
    | 'arch'
    | 'pendant'
    | 'plan'
    | 'furniture'
    | 'mark';
  size?: number;
  class?: string;
}

const { name, size = 20, class: cls = '' } = Astro.props;

const paths: Record<Props['name'], string> = {
  search: '<circle cx="11" cy="11" r="7"/><path d="M20.5 20.5 16.7 16.7"/>',
  menu: '<path d="M3 7h18M3 12h18M3 17h18"/>',
  close: '<path d="M5 5l14 14M19 5 5 19"/>',
  arrow: '<path d="M2 12h19M15.5 6.5 21 12l-5.5 5.5"/>',
  chevron: '<path d="M6 9l6 6 6-6"/>',
  pin: '<path d="M12 21s-7-6.2-7-11a7 7 0 1 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>',
  mail: '<rect x="3" y="5.5" width="18" height="13" rx="0"/><path d="m3.5 7 8.5 6 8.5-6"/>',
  phone: '<path d="M7 4h3.5l1.5 4.5-2.2 1.7a12.5 12.5 0 0 0 4 4l1.7-2.2L20 13.5V17a2 2 0 0 1-2 2A15 15 0 0 1 5 6a2 2 0 0 1 2-2z"/>',
  // Service glyphs (40px, stroke 1.25)
  arch: '<path d="M6 21v-9a6 6 0 0 1 12 0v9"/><path d="M3 21h18"/>',
  pendant: '<path d="M12 3v4"/><circle cx="12" cy="13" r="6"/><path d="M3 13h4M17 13h4"/>',
  plan: '<rect x="5" y="5" width="14" height="14"/><path d="M5 5l14 14"/><path d="M9 9v3h3"/>',
  furniture: '<path d="M4 20h16M6 20V9l6-4 6 4v11"/><path d="M6 13h12"/>',
  // Building mark (contact panel)
  mark: '<path d="M9 21V4h4v17M9 7h4"/><path d="M15 21v-6h6v6M15 15h6"/><path d="M5 21h16"/>',
};

const isService = ['arch', 'pendant', 'plan', 'furniture', 'mark'].includes(name);
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={isService ? 1.25 : 1.5}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
