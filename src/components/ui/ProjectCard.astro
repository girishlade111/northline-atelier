---
/**
 * ProjectCard — image on top, hairline info box below (left/right/bottom borders).
 * Non-linked article (single-page site has no detail routes); the id lets
 * search results deep-link to a specific project card.
 */
import type { Locale } from '../../config/site';
import { useTranslations } from '../../i18n/ui';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../ui/Icon.astro';

interface Props {
  locale: Locale;
  slug: string;
  title: string;
  category: 'residential' | 'hospitality' | 'commercial';
  location: string;
  image: ImageMetadata;
  alt: string;
}
const { locale, slug, title, category, location, image, alt } = Astro.props;
const t = useTranslations(locale);
---

<article class="card" id={`project-${slug}`}>
  <span class="card-media">
    <Picture
      src={image}
      formats={['avif', 'webp', 'jpg']}
      widths={[600, 900, 1200]}
      sizes="(max-width: 767px) 80vw, (max-width: 1023px) 45vw, 30vw"
      width={1600}
      height={1100}
      alt={alt}
      loading="lazy"
      class="card-img"
    />
  </span>
  <span class="card-info">
    <span class="row row-1">
      <span class="title">{title}</span>
      <span class="category">{t.projects.category[category]}</span>
    </span>
    <span class="row row-2">
      <span class="location">{location}</span>
      <Icon name="arrow" size={20} class="card-arrow" />
    </span>
  </span>
</article>

<style>
  .card {
    display: block;
    color: var(--ink);
  }
  .card-media {
    display: block;
    overflow: hidden;
    aspect-ratio: 1.45 / 1;
    background: var(--bg-alt);
  }
  .card-media :global(.card-img),
  .card-media :global(picture) {
    width: 100%;
    height: 100%;
  }
  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease-out);
  }
  .card:hover :global(img),
  .card:focus-visible :global(img) {
    transform: scale(1.04);
  }
  .card-info {
    display: block;
    border-left: 1px solid var(--line);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 14px 16px;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .row-1 {
    margin-bottom: 6px;
  }
  .title {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition: background-size 0.4s var(--ease-out);
    padding-bottom: 2px;
  }
  .card:hover .title,
  .card:focus-visible .title {
    background-size: 100% 1px;
  }
  .category {
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    white-space: nowrap;
  }
  .location {
    font-size: 12px;
    color: var(--ink);
  }
  :global(.card-arrow) {
    width: 20px;
    height: 11px;
    flex: none;
    align-self: center;
    transition: transform 0.35s var(--ease-out);
  }
  .card:hover :global(.card-arrow),
  .card:focus-visible :global(.card-arrow) {
    transform: translateX(6px);
  }
</style>
