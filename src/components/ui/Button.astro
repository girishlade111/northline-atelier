---
/**
 * Button — sharp corners, olive fill or ink outline.
 * Renders <a> when `href` is given, else <button>.
 */
import Icon from './Icon.astro';

interface Props {
  href?: string;
  variant?: 'fill' | 'outline';
  type?: 'button' | 'submit';
  class?: string;
  disabled?: boolean;
}
const { href, variant = 'fill', type = 'button', class: cls = '', disabled = false } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  type={href ? undefined : type}
  disabled={disabled}
  class:list={['btn', `btn--${variant}`, cls]}
>
  <span class="btn-label"><slot /></span>
  <Icon name="arrow" size={28} class="btn-arrow" />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 59px;
    padding: 0 26px;
    border-radius: 0;
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition:
      background-color 0.35s var(--ease-out),
      color 0.35s var(--ease-out),
      border-color 0.35s var(--ease-out);
  }
  .btn-label {
    white-space: nowrap;
  }
  :global(.btn-arrow) {
    width: 28px;
    height: 14px;
    flex: none;
    transition: transform 0.35s var(--ease-out);
  }
  .btn:hover :global(.btn-arrow),
  .btn:focus-visible :global(.btn-arrow) {
    transform: translateX(6px);
  }
  .btn--fill {
    background: var(--olive);
    color: var(--on-olive);
    border: 1px solid var(--olive);
  }
  .btn--fill:hover {
    background: var(--olive-dark);
    border-color: var(--olive-dark);
  }
  .btn--outline {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--ink);
  }
  .btn--outline:hover {
    background: var(--ink);
    color: var(--bg);
  }
  .btn[disabled] {
    opacity: 0.55;
    cursor: wait;
  }
</style>
