---
/** ArrowLink — small uppercase text link with a thin arrow that extends on hover. */
import Icon from './Icon.astro';

interface Props {
  href: string;
  class?: string;
}
const { href, class: cls = '' } = Astro.props;
---

<a href={href} class:list={['arrow-link', cls]}>
  <span class="text"><slot /></span>
  <Icon name="arrow" size={22} class="icon" />
</a>

<style>
  .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .arrow-link .text {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition: background-size 0.4s var(--ease-out);
    padding-bottom: 2px;
  }
  .arrow-link:hover .text,
  .arrow-link:focus-visible .text {
    background-size: 100% 1px;
  }
  .arrow-link :global(.icon) {
    width: 22px;
    height: 12px;
    transition: transform 0.35s var(--ease-out);
  }
  .arrow-link:hover :global(.icon),
  .arrow-link:focus-visible :global(.icon) {
    transform: translateX(6px);
  }
</style>
